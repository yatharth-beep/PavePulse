# Development-only local configuration. Do not use these values for a public deployment.
APP_ENV=development
DATABASE_URL=sqlite:///./pavepulse.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIMULATOR_ENABLED=true
SEED_ON_STARTUP=true
JWT_SECRET=development-only-secret-change-before-production-32bytes
BOOTSTRAP_ENGINEER_PASSWORD=
DEVICE_API_KEY=dev-device-key-change-me
# Dashboard uses MapLibre with public raster tiles; no API token required.

# Two independent buses must report the repaired location as clear before the incident is verified.
VERIFICATION_REQUIRED_BUSES=2
VERIFICATION_RADIUS_METERS=35

# Supabase Auth + PostgreSQL (set these on the API host, never in frontend source)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_ENGINEER_EMAILS=engineer@pavepulse.local
SUPABASE_WORKER_EMAILS=worker@pavepulse.local
DEMO_DATA_ENABLED=false
