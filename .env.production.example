# Docker Compose self-hosting example. For Render + Supabase PostgreSQL, follow docs/VERCEL_SUPABASE_DEPLOYMENT.md.
POSTGRES_PASSWORD=replace_with_strong_url_safe_secret
APP_ENV=production
JWT_SECRET=replace_with_a_unique_random_secret_of_32_or_more_characters
BOOTSTRAP_ENGINEER_PASSWORD=replace_with_unique_password_at_least_14_chars_if_using_local_API_auth
CORS_ORIGINS=https://pave-pulse.vercel.app
SUPABASE_URL=https://your-project-ref.supabase.co
# Leave blank for asymmetric/JWKS Supabase signing; set only for legacy HS256 projects.
SUPABASE_JWT_SECRET=
SUPABASE_ENGINEER_EMAILS=engineer@pavepulse.local
SUPABASE_WORKER_EMAILS=worker@pavepulse.local
DEVICE_API_KEY=replace_with_a_unique_random_device_ingestion_secret
SIMULATOR_ENABLED=false
SEED_ON_STARTUP=false
DEMO_DATA_ENABLED=false
VERIFICATION_REQUIRED_BUSES=2
VERIFICATION_RADIUS_METERS=35
VITE_API_BASE=
